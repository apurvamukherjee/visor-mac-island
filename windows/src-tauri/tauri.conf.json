{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Visor",
  "version": "0.1.0",
  "identifier": "com.apurvamukherjee.visor",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "Apurva Mukherjee",
    "shortDescription": "A Dynamic Island for Windows",
    "copyright": "© Apurva Mukherjee",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Visor",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      }
    }
  }
}
